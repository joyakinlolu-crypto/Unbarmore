NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://api.unbarmore.com
# Web companion (web/) — used in DASHBOARD / Sunday-report login links
WEB_APP_URL=https://app.unbarmore.com
# Which processes this container runs: all | api | workers | cron
PROCESS_ROLE=all

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Public bot number (E.164, no +) used in wa.me referral & payment-return links
WHATSAPP_DISPLAY_NUMBER=234XXXXXXXXXX
# Optional: your own WhatsApp to receive payout requests
OPS_ALERT_PHONE=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_CEO_TEMPLATE=unbarmore_weekly_ceo_report
WHATSAPP_TEMPLATE_LANG=en

# Google Gemini
GEMINI_API_KEY=
# NOTE: gemini-2.5-flash / -lite are closed to new API keys (404). Verified working: gemini-3.1-flash-lite.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# TTS: google | azure
TTS_PROVIDER=google
# Google Cloud TTS uses Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_TTS_VOICE=en-NG-Chirp3-HD-Achird
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=en-NG-AbeoNeural

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_STARTER_MONTHLY=PLN_xxx
PAYSTACK_PLAN_STARTER_ANNUAL=PLN_xxx
PAYSTACK_PLAN_GROWTH_MONTHLY=PLN_xxx
PAYSTACK_PLAN_GROWTH_ANNUAL=PLN_xxx

# Google Sheets (growth tier) — service account JSON, base64-encoded
GOOGLE_SHEETS_SA_JSON_B64=

# Video assets
BGM_DIR=./assets/bgm
FONT_PATH=./assets/fonts/DejaVuSans-Bold.ttf

# ── Optional ──────────────────────────────────────────────
# Owner of the platform: only this number can use the ADMIN command (digits only)
ADMIN_PHONE=
# Shown by SUPPORT and when payments aren't live yet, e.g. https://wa.me/2348012345678
SUPPORT_WHATSAPP_URL=
# Paystack is optional: leave blank (or placeholder) and plans say "payment opens very soon"
# PAYSTACK_SECRET_KEY=
# After this many ms of waiting on the AI, the user gets "Processing your entry..."
INTERIM_NOTICE_MS=12000
