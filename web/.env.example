# Same Supabase project as the WhatsApp backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random chars — signs the 30-day session cookie. `openssl rand -base64 48`
JWT_SECRET=

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Used by /login to send a link (only inside the free 24h window)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# Public URL of this app (used inside WhatsApp login links)
APP_URL=https://app.unbarmore.com
# Bot number, E.164 without + (wa.me links: LOGIN, PLANS, referral share)
WHATSAPP_DISPLAY_NUMBER=234XXXXXXXXXX
